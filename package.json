{
  "name": "dayzero-planner",
  "private": true,
  "version": "1.0.0",
  "description": "Cross-platform date planner and countdown dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc -b --noEmit",
    "typecheck": "tsc -b --pretty false",
    "electron:build": "npm run build && electron-builder --win nsis --publish never",
    "android:sync": "npm run build && cap sync android"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.dayzero.planner",
    "productName": "DayZero",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "npmRebuild": false,
    "asar": true,
    "compression": "normal"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "firebase": "^12.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "author": "DayZero"
}
